<?xml version="1.0"?>
<!--
  Local development overrides.

  ClickHouse defaults assume a dedicated server. These caps keep it well-behaved
  as one container among several on a laptop, which is the environment a hackathon
  reviewer will actually run it in. None of this is tuning for performance — the
  dataset is small; it is tuning to not evict the reviewer's browser from memory.
-->
<clickhouse>
    <logger>
        <level>warning</level>
        <console>1</console>
    </logger>

    <!--
      Listen on all interfaces.

      This is required, not cosmetic. The stock config.xml in the official image
      sets only:

          <listen_host>::1</listen_host>
          <listen_host>127.0.0.1</listen_host>

      so the server listens on the *container's own* loopback and nothing else.
      Docker's published port then forwards to the container's eth0 address,
      which nothing is listening on, and the connection is accepted by the proxy
      and immediately closed by the container. The symptom is a healthy
      container (its healthcheck runs inside, over loopback, and passes) that the
      host cannot reach — "Empty reply from server" rather than "connection
      refused", which sends you hunting for an application fault that is not
      there.

      replace="replace" swaps the whole listen_host set rather than appending to
      it, avoiding a redundant bind on addresses 0.0.0.0 already covers.
    -->
    <listen_host replace="replace">0.0.0.0</listen_host>

    <!-- 2 GiB ceiling for the server process. -->
    <max_server_memory_usage>2147483648</max_server_memory_usage>

    <!-- The dataset is a few hundred thousand rows; large mark/uncompressed
         caches would be pure waste here. -->
    <mark_cache_size>268435456</mark_cache_size>
    <uncompressed_cache_size>134217728</uncompressed_cache_size>

    <!-- Background pool sizes are deliberately left at their defaults.
         ClickHouse enforces
           background_pool_size × background_merges_mutations_concurrency_ratio
             ≥ number_of_free_entries_in_pool_to_execute_mutation (20)
         and refuses to start if the product is smaller, because mutations
         could never acquire a slot. Shrinking the pool to be neighbourly on a
         laptop trips that invariant; the memory caps above achieve the same
         goal without breaking startup. -->

    <!-- Query log is genuinely useful when demonstrating that the rollups are
         doing the work, but cap its retention so it cannot outgrow the data. -->
    <query_log>
        <database>system</database>
        <table>query_log</table>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
        <flush_interval_milliseconds>7500</flush_interval_milliseconds>
    </query_log>
</clickhouse>
