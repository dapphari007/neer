# ─── ClickHouse (hot path — required) ─────────────────────────────────────────
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=neer
CLICKHOUSE_PASSWORD=neer_local_dev
CLICKHOUSE_DATABASE=neer

# ─── API ──────────────────────────────────────────────────────────────────────
API_PORT=3000
API_CORS_ORIGIN=http://localhost:5173

# ─── Seed pipeline ────────────────────────────────────────────────────────────
# Open-Meteo requires no API key. Historical archive window for seeded weather.
SEED_START_DATE=2025-03-01
SEED_END_DATE=2025-09-15
SEED_RANDOM_SEED=20260918

# ─── Analytics providers ──────────────────────────────────────────────────────
# forecast: "local" (default, zero credentials) | "bqml"  (requires GCP)
FORECAST_PROVIDER=local
# narrative: "template" (default, deterministic) | "vertex" (requires GCP)
NARRATIVE_PROVIDER=template

# ─── BigQuery cold path (dormant — only needed when FORECAST_PROVIDER=bqml) ────
# GCP_PROJECT_ID=
# GCP_LOCATION=EU
# BIGQUERY_DATASET=neer_analytics
# GOOGLE_APPLICATION_CREDENTIALS=./gcp-key.json
