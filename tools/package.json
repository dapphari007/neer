{
  "name": "@neer/tools",
  "version": "0.1.0",
  "private": true,
  "description": "Migration, seeding and batch computation for Neer",
  "license": "MIT",
  "main": "./dist/cli.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "migrate": "tsx src/cli.ts migrate",
    "seed": "tsx src/cli.ts seed",
    "compute": "tsx src/cli.ts compute",
    "export-demo": "tsx src/cli.ts export-demo",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@clickhouse/client": "^1.10.0",
    "@neer/insights": "workspace:*",
    "@neer/scoring": "workspace:*",
    "@neer/shared": "workspace:*"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
